{
  "name": "@dsh-eac/skin-loader-pack",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH UI 皮肤加载器 Git 分发组合包：以仓内固定制品经 patch 挂载 @dsh-eac/ui-skin-loader（分发契约见 docs/git-distribution.md）。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "files": [
    "cordis.patch.yml",
    "packages/loader/lib",
    "packages/loader/cordis.patch.yml",
    "packages/loader/package.json",
    "packages/loader/skin-manifest.json",
    "packages/loader/README.md",
    "packages/loader/LICENSE",
    "packages/loader/NOTICE",
    "packages/loader/THIRD-PARTY-NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild-wasm": "0.25.10",
    "eslint": "^10.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
